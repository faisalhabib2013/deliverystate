# ════════════════════════════════════════════════════════════
# COD Meta Tracking — Environment Variables
# ════════════════════════════════════════════════════════════
# انسخ هذا الملف لـ .env واملأ القيم
# في Railway/Heroku/Render: ادخل القيم في لوحة الـ Variables

# ─── Required: Easy Orders ───────────────────────────────────
# من Easy Orders → Settings → Webhooks → Secret
EASY_ORDERS_SECRET=

# من Easy Orders → Settings → API Keys → Public API Keys
EASY_ORDERS_API_KEY=

# Store IDs (مفصولة بفاصلة لو عندك أكثر من متجر على نفس API key)
# مثال متجر واحد:    EASY_ORDERS_STORE_IDS=c0ad812b-7ad8-4bf3-b5f2-c124aed015be
# مثال متاجر متعددة: EASY_ORDERS_STORE_IDS=c0ad812b-...,a1b2c3d4-...,e5f6g7h8-...
EASY_ORDERS_STORE_IDS=

# ─── Required: Bosta ─────────────────────────────────────────
# من Bosta Dashboard → Settings → API Keys
BOSTA_API_KEY=

# ─── Required: Meta CAPI ─────────────────────────────────────
# Meta Events Manager → Pixel → Data Sources → Pixel ID
META_PIXEL_ID=

# Meta Events Manager → Pixel → Settings → CAPI → Generate Access Token
META_CAPI_TOKEN=

# ─── Required: Redis (مطلوب للحفاظ على البيانات بعد restart) ─
# في Railway: أضف Redis plugin وسيتم تعيين هذه تلقائياً
REDIS_URL=

# ─── Required: CORS Origins ──────────────────────────────────
# الدومينات المسموح لها بإرسال signals، مفصولة بفاصلة
# مثال: ALLOWED_ORIGINS=https://store.shop,https://www.store.shop
ALLOWED_ORIGINS=

# ─── Optional ────────────────────────────────────────────────
# منفذ السيرفر (Railway يعيّنه تلقائياً)
PORT=3000

# العملة الافتراضية
CURRENCY=EGP

# كود الدولة ISO (سيُطبق عليه sha256 لـ Meta)
COUNTRY_CODE=eg

# تخطي إرسال OrderReturned events (true/false)
SKIP_RETURNED_EVENTS=false

# تحديث حالة الأوردر في Easy Orders بعد التسليم (true/false)
# افتراضياً false لأن Easy Orders يحدّث الحالة بنفسه
UPDATE_EASY_ORDERS_STATUS=false

# اسم الـ Custom Event في Meta للتسليم (يجب أن يطابق Custom Conversion)
EVENT_NAME_DELIVERY=Delivery

# اسم الـ Custom Event للإرجاع
EVENT_NAME_RETURNED=OrderReturned

# مدة الاحتفاظ بالبيانات (بالثواني)
TTL_SIGNAL=14400        # 4 ساعات
TTL_ORDER=864000        # 10 أيام
TTL_TRACKING=864000     # 10 أيام

# نافذة الـ time-based matching (ثواني)
SIGNAL_MATCH_WINDOW_SECONDS=180
