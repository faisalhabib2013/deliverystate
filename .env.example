# ─── Bosta ────────────────────────────────────────────────────────
BOSTA_API_KEY=your_bosta_api_key_here

# ─── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://...   # يُضاف تلقائياً من Railway Redis plugin

# ─── Store 1 ──────────────────────────────────────────────────────
STORE_1_NAME=mystore
STORE_1_DOMAINS=https://mystore.com,https://www.mystore.com
STORE_1_EASY_ORDERS_SECRET=your_easy_orders_secret
STORE_1_META_PIXEL_ID=123456789012345
STORE_1_META_CAPI_TOKEN=your_meta_capi_token

# ─── Store 2 (اختياري) ───────────────────────────────────────────
# STORE_2_NAME=mystore2
# STORE_2_DOMAINS=https://mystore2.com
# STORE_2_EASY_ORDERS_SECRET=...
# STORE_2_META_PIXEL_ID=...
# STORE_2_META_CAPI_TOKEN=...

# يمكن إضافة حتى STORE_20_*

# ─── Legacy (متوافق للخلف، يُنصح بـ STORE_N_* بدلاً منه) ─────────
